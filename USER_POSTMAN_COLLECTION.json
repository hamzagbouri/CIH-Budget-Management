	"item": [
		{
			"name": "Dashboard",
			"item": [
				{
					"name": "Get User Dashboard",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/user/dashboard?annee=2024",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"user",
								"dashboard"
							],
							"query": [
								{
									"key": "annee",
									"value": "2024",
									"description": "Année pour filtrer les données (optionnel, défaut: année courante)"
								}
							]
						},
						"description": "Récupère le tableau de bord complet de l'utilisateur connecté avec toutes les statistiques de son département"
					},
					"response": []
				}
			],
			"description": "APIs pour le tableau de bord utilisateur"
